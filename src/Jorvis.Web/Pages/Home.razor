@page "/"
@inject ProjectApiClient Api
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Jorvis — Projects</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Projects</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="CreateAsync">
        New project
    </MudButton>
</div>

@if (_invitations.Count > 0)
{
    <MudText Typo="Typo.h6" Class="mb-2">Invitations</MudText>
    <MudStack Spacing="2" Class="mb-6">
        @foreach (var invitation in _invitations)
        {
            <MudPaper Class="pa-4 d-flex align-center flex-wrap gap-2" Elevation="1">
                <div class="flex-grow-1">
                    <MudText Typo="Typo.body1"><b>@invitation.InvitedBy</b> invited you to <b>@invitation.ProjectName</b></MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@invitation.ProjectLabel</MudText>
                </div>
                <MudButton Variant="Variant.Text" OnClick="@(() => DeclineAsync(invitation))">Decline</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => AcceptAsync(invitation))">Join</MudButton>
            </MudPaper>
        }
    </MudStack>
}

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (_projects.Count == 0)
{
    <MudText Typo="Typo.body1" Class="mud-text-secondary">
        You're not in any projects yet. Create one or ask someone to invite you to one.
    </MudText>
}
else
{
    <MudGrid Spacing="3">
        @foreach (var project in _projects)
        {
            <MudItem xs="12" sm="6" md="4">
                <a href="@($"projects/{project.Label}")" class="project-link">
                    <MudCard Elevation="1" Class="project-card">
                        <MudCardContent>
                            <MudText Typo="Typo.h6" Class="text-truncate">@project.Name</MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@project.Label</MudText>
                            <div class="d-flex align-center gap-2 mt-3">
                                <MudIcon Icon="@Icons.Material.Outlined.People" Size="Size.Small" Class="mud-text-secondary" />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                    @project.MemberCount @(project.MemberCount == 1 ? "member" : "members")
                                </MudText>
                                @if (project.Role == ProjectRole.Owner)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Owner</MudChip>
                                }
                            </div>
                        </MudCardContent>
                    </MudCard>
                </a>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<ProjectSummaryResponse> _projects = [];
    private List<InvitationResponse> _invitations = [];
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var projects = Api.GetProjectsAsync();
            var invitations = Api.GetInvitationsAsync();
            _projects = await projects;
            _invitations = await invitations;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not load projects: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateAsync()
    {
        var dialog = await Dialogs.ShowAsync<NewProjectDialog>(
            "New project", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: ProjectResponse project })
            Navigation.NavigateTo($"projects/{project.Label}");
    }

    private async Task AcceptAsync(InvitationResponse invitation)
    {
        try
        {
            var project = await Api.AcceptInvitationAsync(invitation.ProjectLabel);
            Navigation.NavigateTo($"projects/{project.Label}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not join: {ex.Message}", Severity.Error);
            await LoadAsync();
        }
    }

    private async Task DeclineAsync(InvitationResponse invitation)
    {
        try
        {
            await Api.DeclineInvitationAsync(invitation.ProjectLabel);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not decline: {ex.Message}", Severity.Error);
        }

        await LoadAsync();
    }
}
