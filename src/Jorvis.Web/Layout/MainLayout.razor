@inherits LayoutComponentBase
@implements IDisposable
@inject ThemeState Themes
@inject NavigationManager Navigation

<MudThemeProvider @ref="_themeProvider" Theme="Themes.Current.Theme" IsDarkMode="Themes.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudDrawer @bind-Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="0"
               Width="280px" ClipMode="DrawerClipMode.Never">
        <div class="d-flex flex-column" style="height: 100%;">
            <div class="d-flex align-center justify-space-between pa-4">
                <MudText Typo="Typo.h6">Jorvis</MudText>
                <MudIconButton Icon="@Icons.Material.Outlined.ViewSidebar" Size="Size.Small" OnClick="@ToggleDrawer"
                               aria-label="Close sidebar" />
            </div>
            <NavMenu />
            <div class="flex-grow-1"></div>
            <div class="persona pa-2">
                <UserPersona />
            </div>
        </div>
    </MudDrawer>
    <MudMainContent Style="padding-top: 0;">
        @* Always there, so opening or closing the drawer never moves the page up or down. *@
        <div class="main-header d-flex align-center px-2">
            @if (!_drawerOpen)
            {
                <MudIconButton Icon="@Icons.Material.Outlined.ViewSidebar" OnClick="@ToggleDrawer" aria-label="Open sidebar" />
            }
        </div>
        <MudContainer MaxWidth="@(IsBoard ? MaxWidth.False : MaxWidth.Medium)" Class="pb-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _drawerOpen = true;

    // A project's board gets the whole width for its lanes.
    private bool IsBoard => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("projects/", StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        Themes.Changed += OnThemeChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await Themes.InitializeAsync();
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Themes.Changed -= OnThemeChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            Themes.UseSystemMode(await _themeProvider.GetSystemDarkModeAsync());
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}
